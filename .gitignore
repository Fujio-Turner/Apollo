# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# Graph Search data
.apollo/
.graph_search/


# Target directory (user-provided codebase to index)
target/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
_dev_only/
*.log
_apollo*
data/index.json

# User-local Apollo state in data/ (created at runtime; user-specific
# absolute paths and last-opened-project pointers must not be committed).
data/settings.json
data/_apollo/
data/_apollo_web/
data/logs/

# Couchbase Lite shared-library binaries downloaded by the in-app
# installer (Settings → Storage). Tens of MB of platform-specific
# .dylib/.dll/.so files — never commit. The folder itself is kept in
# git (via storage_binary/.gitkeep) so the installer always has a
# target dir to write into.
storage_binary/*
!storage_binary/.gitkeep

# Couchbase Lite databases (per-project + global). The .cblite2 directory
# can grow to many MB; never commit it.
*.cblite2
*.cblite2/
*.cblite2-shm
*.cblite2-wal
*.cblite2-journal

# Local test/demo projects that aren't part of the repo
sg-completed-requests/
sg-log-reader-demo/